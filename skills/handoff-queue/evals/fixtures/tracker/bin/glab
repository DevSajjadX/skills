#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# ///
"""Stub tracker CLI over ../data.json. Every call is appended to ../glab.log."""
import json
import pathlib
import sys

root = pathlib.Path(__file__).resolve().parent.parent
args = sys.argv[1:]
with open(root / "glab.log", "a") as log:
    log.write(" ".join(args) + "\n")
data = json.loads((root / "data.json").read_text())
issues = data["issues"]

if args[:1] == ["api"]:
    path = args[1]
    if "milestones" in path:
        print(json.dumps([data["milestone"]]))
    elif path.endswith("/links"):
        print(json.dumps(issues[path.split("/")[-2]]["links"]))
    elif "/issues/" in path:
        print(json.dumps(issues[path.split("/")[-1]]))
    else:
        print(json.dumps([{k: v for k, v in i.items() if k != "links"} for i in issues.values()]))
elif args[:2] == ["issue", "view"]:
    i = issues[args[2]]
    print(f"#{i['iid']} {i['title']}\nlabels: {', '.join(i['labels'])}\n\n{i['description']}")
elif args[:2] in (["issue", "update"], ["issue", "note"], ["mr", "merge"]):
    print("ok")
else:
    print("unsupported: " + " ".join(args), file=sys.stderr)
    sys.exit(1)
