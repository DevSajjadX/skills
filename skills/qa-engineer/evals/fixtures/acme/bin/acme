#!/usr/bin/env python3
"""Stub launcher for the fictional acme app (QA evals): stdlib only, fake data.

`acme run --isolated` binds a random port, prints the dashboard line, and serves
the web pages and the /api proxy prefix on that one origin. Known gaps on purpose:
an unknown /api route answers 404 with a null detail, and one error key has an
English sentence only. Tenant-owned rows (products, verification, audit entries) are
readable and changeable by id: the owner gets 200/201, any other tenant or a missing id gets 404
problem+json, never the row and never a 500. Sign-in returns to the page asked for: /auth?next=...
shows a form, verify answers {"next": ...} (same-site paths only, else "/"), and /auth with a live
session redirects 302 to next. The first load of / carries a hot-reload overlay and the
first /api/health answers 503 (container still starting); later loads are clean.
"""
import json
import re
import sys
from urllib.parse import parse_qs
from http.server import BaseHTTPRequestHandler, HTTPServer

MOBILES = {"+15550000001": "a", "+15550000002": "b", "+15550000003": "staff"}
PRODUCTS = {1: ("a", "Widget"), 2: ("a", "Gadget"), 3: ("b", "Sprocket")}
VERIFICATIONS = {1: ("a", "pending"), 2: ("b", "pending")}
AUDIT = {1: ("a", "product 1 created"), 2: ("b", "product 3 created")}
CODES = {}
SEEN = {"home": False, "health": False}
TEXT = {
    "notFound": {"en": "Not found.", "ar": "غير موجود."},
    "badBody": {"en": "Unreadable body."},
}


TABLES = {"products": PRODUCTS, "verification": VERIFICATIONS, "audit": AUDIT}
VALUE = {"products": "name", "verification": "status", "audit": "text"}
AUTH_PAGE = b"""<h1>Sign in</h1><form id=f>
<input name=mobile placeholder=mobile><input name=code placeholder=code><button>Sign in</button></form>
<script>f.onsubmit=async e=>{e.preventDefault();const h={"Content-Type":"application/json","X-Requested-With":"acme-web"},
m=f.mobile.value;await fetch("/api/auth/start",{method:"POST",headers:h,body:JSON.stringify({mobile:m})});
const r=await fetch("/api/auth/verify",{method:"POST",headers:h,body:JSON.stringify({mobile:m,code:f.code.value,next:__NEXT__})});
if(r.ok)location=(await r.json()).next}</script>"""


def safe_next(value):
    return value if value.startswith("/") and not value.startswith("//") else "/"


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def who(self):
        for part in self.headers.get("Cookie", "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == "sess" and v in ("a", "b", "staff"):
                return v

    def out(self, status, body, ctype="application/json", headers=()):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def err(self, status, key, detail=True):
        lang = "ar" if self.headers.get("Accept-Language", "").startswith("ar") else "en"
        msg = TEXT[key].get(lang, TEXT[key]["en"]) if detail else None
        self.out(status, {"status": status, "detail": msg, "errorKey": key}, "application/problem+json")

    def body(self):
        try:
            return json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
        except ValueError:
            return None

    def do_GET(self):
        path, _, query = self.path.partition("?")
        if path == "/":
            overlay = b"" if SEEN["home"] else b'<div id="vite-error-overlay">HMR update failed</div>'
            SEEN["home"] = True
            return self.out(200, b"<h1>Acme</h1>" + overlay, "text/html")
        if path == "/auth":
            nxt = safe_next(parse_qs(query).get("next", ["/"])[0])
            if self.who():
                return self.out(302, b"", "text/html", [("Location", nxt)])
            return self.out(200, AUTH_PAGE.replace(b"__NEXT__", json.dumps(nxt).replace("<", "\\u003c").encode()), "text/html")
        if path.startswith("/app/"):
            if not self.who():
                return self.out(302, b"", "text/html", [("Location", "/auth?next=" + path)])
            return self.out(200, b"<h1>Products</h1>", "text/html")
        if path == "/api/health":
            if not SEEN["health"]:
                SEEN["health"] = True
                return self.out(503, {"status": "starting"})
            return self.out(200, {"status": "ok"})
        if path == "/api/dev/sent-sms":
            m = re.search(r"mobile=([^&]+)", query)
            mobile = "+" + m.group(1).lstrip("+").replace("%2B", "") if m else ""
            return self.out(200, {"text": "Your code is " + CODES.get(mobile, "000000")})
        if path == "/api/categories":
            return self.out(200, [{"id": 1, "name": "Hardware"}])
        who = self.who()
        if path.startswith("/api/") and not who and path != "/api/health":
            return self.err(404, "notFound")
        if path == "/api/products":
            return self.out(200, [{"id": i, "name": n} for i, (t, n) in PRODUCTS.items() if t == who])
        m = re.fullmatch(r"/api/(products|verification|audit)(?:/(\d+))?", path)
        if m and m.group(2):
            row = TABLES[m.group(1)].get(int(m.group(2)))
            return self.out(200, {"id": int(m.group(2)), VALUE[m.group(1)]: row[1]}) if row and row[0] == who else self.err(404, "notFound")
        if m and m.group(1) != "products":
            return self.out(200, [{"id": i, VALUE[m.group(1)]: v} for i, (t, v) in TABLES[m.group(1)].items() if t == who])
        self.out(404, {"status": 404, "detail": None})

    def do_POST(self):
        path = self.path.partition("?")[0]
        data = self.body()
        if data is None:
            return self.err(400, "badBody")
        if path == "/api/auth/start":
            if data.get("mobile") in MOBILES:
                CODES[data["mobile"]] = "123456"
            return self.out(202, {})
        if path == "/api/auth/verify":
            team = MOBILES.get(data.get("mobile"))
            if team and CODES.get(data["mobile"]) == data.get("code"):
                return self.out(200, {"next": safe_next(data.get("next", "/"))}, headers=[("Set-Cookie", "sess=%s; Path=/; HttpOnly" % team)])
            return self.err(404, "notFound")
        who = self.who()
        if path == "/api/products" and who:
            pid = max(PRODUCTS) + 1
            PRODUCTS[pid] = (who, str(data.get("name", "")))
            aid = max(AUDIT) + 1
            AUDIT[aid] = (who, "product %d created" % pid)
            return self.out(201, {"id": pid})
        if path == "/api/verification" and who:
            vid = max(VERIFICATIONS) + 1
            VERIFICATIONS[vid] = (who, "pending")
            return self.out(201, {"id": vid})
        self.err(404, "notFound")

    def do_PUT(self):
        data = self.body()
        m = re.fullmatch(r"/api/(products|verification|audit)/(\d+)", self.path.partition("?")[0])
        who = self.who()
        if data is None:
            return self.err(400, "badBody")
        row = TABLES[m.group(1)].get(int(m.group(2))) if m else None
        if not (who and row and row[0] == who):
            return self.err(404, "notFound")
        TABLES[m.group(1)][int(m.group(2))] = (who, str(data.get(VALUE[m.group(1)], row[1])))
        self.out(200, {"id": int(m.group(2))})

    def do_DELETE(self):
        m = re.fullmatch(r"/api/products/(\d+)", self.path.partition("?")[0])
        who = self.who()
        row = PRODUCTS.get(int(m.group(1))) if m else None
        if not (who and row and row[0] == who):
            return self.err(404, "notFound")
        del PRODUCTS[int(m.group(1))]
        self.out(204, b"")


def main():
    srv = HTTPServer(("127.0.0.1", 0), H)
    print("Web: http://127.0.0.1:%d" % srv.server_port, flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    if sys.argv[1:3] != ["run", "--isolated"]:
        sys.exit("usage: acme run --isolated")
    main()
